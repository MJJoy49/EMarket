@page "/change-password"
@using EMarket.Shared.Dtos.Auth
@{
    ViewData["Title"] = "Change password";
}
@functions {
    [BindProperty] public ChangePasswordRequest Input { get; set; } = new();

    public bool MustChange => User.FindFirst("mustChangePassword")?.Value == "true";

    public async Task<IActionResult> OnPostAsync()
    {
        if (!ModelState.IsValid) { Clear(); return Page(); }
        var result = await Api.PostAsync<TokenResponse>("api/v1/auth/change-password", Input);
        if (!result.Ok || result.Data is null)
        {
            Clear();
            ModelState.AddModelError(string.Empty, result.Message);
            return Page();
        }

        // The API ended every other session (FR-1.16); this one continues with the new tokens.
        await SignInHelper.SignInAsync(HttpContext, result.Data, persistent: false);
        Success(Messages.Saved + " Other devices were signed out.");
        return result.Data.Roles.Contains(Roles.Admin) ? RedirectToPage("/Index", new { area = "Admin" }) : RedirectToPage("/Profile/Index");
    }

    private void Clear() => Input.OldPassword = Input.NewPassword = Input.ConfirmPassword = "";
}

<div class="row justify-content-center"><div class="col-md-6 col-lg-5">
    <h1 class="h3">Change password</h1>
    @if (MustChange) { <div class="alert alert-warning" role="status">Please choose a new password before you continue.</div> }
    <form class="card card-body" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>
        <div class="mb-3"><label class="form-label" asp-for="Input.OldPassword">Current password <span aria-hidden="true">*</span></label><input class="form-control" asp-for="Input.OldPassword" type="password" autocomplete="current-password" required /><span class="text-danger" asp-validation-for="Input.OldPassword"></span></div>
        <div class="mb-3"><label class="form-label" asp-for="Input.NewPassword">New password <span aria-hidden="true">*</span></label><input class="form-control" asp-for="Input.NewPassword" type="password" autocomplete="new-password" required /><div class="form-text">8 to 64 characters with an uppercase letter, a lowercase letter and a number.</div><span class="text-danger" asp-validation-for="Input.NewPassword"></span></div>
        <div class="mb-3"><label class="form-label" asp-for="Input.ConfirmPassword">Confirm new password <span aria-hidden="true">*</span></label><input class="form-control" asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required /><span class="text-danger" asp-validation-for="Input.ConfirmPassword"></span></div>
        <button class="btn btn-primary w-100" type="submit">Change password</button>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
