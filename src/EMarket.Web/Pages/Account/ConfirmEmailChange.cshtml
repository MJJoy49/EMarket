@page "/confirm-email-change"
@using EMarket.Shared.Dtos.Auth
@{
    ViewData["Title"] = "Confirm new email";
}
@functions {
    public bool Done { get; private set; }

    public async Task OnGetAsync(string? token)
    {
        if (string.IsNullOrWhiteSpace(token)) { return; }
        Done = (await Api.PostAsync<Empty>("api/v1/profile/confirm-email-change", new TokenRequest { Token = token })).Ok;
    }
}

<div class="text-center">
    <h1 class="h3">Confirm new email</h1>
    @if (Done) { <p class="lead" role="status">Your new email is confirmed. Use it to log in from now on.</p><a class="btn btn-primary" asp-page="/Account/Login">Log in</a> }
    else { <p class="lead" role="alert">@Messages.BadLink</p> }
</div>
