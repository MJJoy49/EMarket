@page "/admin/audit"
@using EMarket.Shared.Dtos.Admin
@using EMarket.Shared.Results
@{
    ViewData["Title"] = "Audit log";
}
@functions {
    public PagedResult<AuditRowDto>? Rows { get; private set; }

    public async Task OnGetAsync()
    {
        var result = await Api.GetAsync<PagedResult<AuditRowDto>>($"api/v1/admin/audit?action={Uri.EscapeDataString(Request.Query["action"].ToString())}&page={Math.Max(1, int.TryParse(Request.Query["page"], out var p) ? p : 1)}");
        if (!Failed(result)) { Rows = result.Data; }
    }
}

<h1 class="h3">Audit log</h1>
<p class="text-muted">Every block, suspension, setting change, payout and similar action. These rows can never be edited.</p>
<form class="d-flex gap-2 mb-3" method="get">
    <label class="visually-hidden" for="action">Action</label>
    <input class="form-control" id="action" name="action" value="@Request.Query["action"]" placeholder="Filter by action, for example SettingChanged" />
    <button class="btn btn-outline-primary" type="submit">Filter</button>
</form>
@if (Rows is null || Rows.Items.Count == 0) { <p class="text-muted">No entries.</p> return; }
<table class="table table-sm align-middle table-cards">
    <thead><tr><th scope="col">When</th><th scope="col">Who</th><th scope="col">Action</th><th scope="col">Target</th><th scope="col">Before</th><th scope="col">After</th></tr></thead>
    <tbody>
        @foreach (var r in Rows.Items)
        {
            <tr><td data-label="When">@Format.DateTime(r.At)</td><td data-label="Who">@r.UserName</td><td data-label="Action">@r.Action</td><td data-label="Target">@r.EntityName</td><td data-label="Before">@r.OldValue</td><td data-label="After">@r.NewValue</td></tr>
        }
    </tbody>
</table>
<partial name="_Pager" model="(Rows.Page, Rows.TotalPages)" />
