@page "/admin/orders"
@using EMarket.Shared.Dtos.Orders
@using EMarket.Shared.Results
@{
    ViewData["Title"] = "Orders";
}
@functions {
    public PagedResult<OrderListItemDto>? Orders { get; private set; }
    public string Q(string name) => Request.Query[name].ToString();

    public async Task OnGetAsync()
    {
        var url = $"api/v1/admin/orders?status={Uri.EscapeDataString(Q("status"))}&search={Uri.EscapeDataString(Q("search"))}&paymentStatus={Uri.EscapeDataString(Q("paymentStatus"))}&from={Q("from")}&to={Q("to")}&page={Math.Max(1, int.TryParse(Q("page"), out var p) ? p : 1)}";
        var result = await Api.GetAsync<PagedResult<OrderListItemDto>>(url);
        if (!Failed(result)) { Orders = result.Data; }
    }
}

<h1 class="h3">Orders</h1>
<form class="row g-2 mb-3" method="get" role="search">
    <div class="col-12 col-md-4"><label class="form-label" for="search">Order number, buyer or shop</label><input class="form-control" id="search" name="search" value="@Q("search")" /></div>
    <div class="col-6 col-md-2"><label class="form-label" for="status">Status</label>
        <select class="form-select" id="status" name="status"><option value="">All</option>@foreach (var s in new[] { "AwaitingPayment", "Pending", "Confirmed", "Processing", "Shipped", "Delivered", "Cancelled" }) { <option value="@s" selected="@(Q("status") == s)">@Format.Status(s)</option> }</select></div>
    <div class="col-6 col-md-2"><label class="form-label" for="pay">Payment</label>
        <select class="form-select" id="pay" name="paymentStatus"><option value="">All</option>@foreach (var s in new[] { "Initiated", "Unpaid", "Paid", "Failed", "Cancelled", "Expired", "PartlyRefunded", "Refunded" }) { <option value="@s" selected="@(Q("paymentStatus") == s)">@Format.Status(s)</option> }</select></div>
    <div class="col-6 col-md-2"><label class="form-label" for="from">From</label><input class="form-control" id="from" name="from" type="date" value="@Q("from")" /></div>
    <div class="col-6 col-md-2"><label class="form-label" for="to">To</label><input class="form-control" id="to" name="to" type="date" value="@Q("to")" /></div>
    <div class="col-12"><button class="btn btn-outline-primary" type="submit">Filter</button></div>
</form>
@if (Orders is null || Orders.Items.Count == 0) { <p class="text-muted">No orders found.</p> return; }
<table class="table align-middle table-cards">
    <thead><tr><th scope="col">Order</th><th scope="col">Buyer</th><th scope="col">Shop</th><th scope="col">Total</th><th scope="col">Payment</th><th scope="col">Status</th><th scope="col">Date</th></tr></thead>
    <tbody>
        @foreach (var o in Orders.Items)
        {
            <tr>
                <td data-label="Order"><a asp-page="/Orders/Details" asp-route-id="@o.Id">@o.OrderNumber</a></td><td data-label="Buyer">@o.BuyerName</td><td data-label="Shop">@o.ShopName</td><td data-label="Total">@Format.Tk(o.Total)</td>
                <td data-label="Payment"><span class="badge @Format.Badge(o.PaymentStatus)">@Format.Status(o.PaymentStatus)</span></td>
                <td data-label="Status"><span class="badge @Format.Badge(o.Status)">@Format.Status(o.Status)</span></td><td data-label="Date">@Format.Date(o.CreatedAt)</td>
            </tr>
        }
    </tbody>
</table>
<partial name="_Pager" model="(Orders.Page, Orders.TotalPages)" />
