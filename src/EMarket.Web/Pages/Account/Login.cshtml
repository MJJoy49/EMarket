@page "/login"
@using EMarket.Shared.Dtos.Auth
@{
    ViewData["Title"] = "Log in";
}
@functions {
    [BindProperty] public LoginRequest Input { get; set; } = new();
    [BindProperty(SupportsGet = true)] public string? ReturnUrl { get; set; }

    public IActionResult OnGet() => User.Identity?.IsAuthenticated == true ? RedirectToPage("/Index") : Page();

    public async Task<IActionResult> OnPostAsync()
    {
        if (!ModelState.IsValid) { return Page(); }
        var result = await Api.PostAsync<TokenResponse>("api/v1/auth/login", Input);
        if (!result.Ok || result.Data is null)
        {
            Input.Password = "";
            ModelState.AddModelError(string.Empty, result.Message); // one message for a wrong email or password (FR-1.9)
            return Page();
        }

        await SignInHelper.SignInAsync(HttpContext, result.Data, Input.RememberMe);
        if (result.Data.MustChangePassword) { return RedirectToPage("/Account/ChangePassword"); }
        if (IsLocal(ReturnUrl)) { return LocalRedirect(ReturnUrl!); }
        return result.Data.Roles.Contains(Roles.Admin) ? RedirectToPage("/Index", new { area = "Admin" }) : RedirectToPage("/Index");
    }
}

<div class="row justify-content-center"><div class="col-md-6 col-lg-5">
    <h1 class="h3">Log in</h1>
    <form class="card card-body" method="post" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>
        <div class="mb-3"><label class="form-label" asp-for="Input.Email">Email <span aria-hidden="true">*</span></label><input class="form-control" asp-for="Input.Email" type="email" autocomplete="username" required /><span class="text-danger" asp-validation-for="Input.Email"></span></div>
        <div class="mb-3"><label class="form-label" asp-for="Input.Password">Password <span aria-hidden="true">*</span></label><input class="form-control" asp-for="Input.Password" type="password" autocomplete="current-password" required /><span class="text-danger" asp-validation-for="Input.Password"></span></div>
        <div class="form-check mb-3"><input class="form-check-input" asp-for="Input.RememberMe" /><label class="form-check-label" asp-for="Input.RememberMe">Remember me</label></div>
        <button class="btn btn-primary w-100" type="submit">Log in</button>
        <p class="mt-3 mb-0 small"><a asp-page="/Account/ForgotPassword">Forgot password?</a> &middot; New here? <a asp-page="/Account/Register">Register</a></p>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
