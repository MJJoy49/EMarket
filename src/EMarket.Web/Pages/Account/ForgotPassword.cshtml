@page "/forgot-password"
@using EMarket.Shared.Dtos.Auth
@{
    ViewData["Title"] = "Forgot password";
}
@functions {
    [BindProperty] public EmailRequest Input { get; set; } = new();

    public async Task<IActionResult> OnPostAsync()
    {
        if (!ModelState.IsValid) { return Page(); }
        var result = await Api.PostAsync<System.Text.Json.JsonElement>("api/v1/auth/forgot-password", Input);
        if (result.Unreachable) { ModelState.AddModelError(string.Empty, result.Message); return Page(); }
        Success(Messages.ResetSent); // the same answer whether the email exists or not (FR-1.15)
        return RedirectToPage("/Account/Login");
    }
}

<div class="row justify-content-center"><div class="col-md-6 col-lg-5">
    <h1 class="h3">Forgot password</h1>
    <form class="card card-body" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>
        <p class="text-muted">We will send a reset link. It works once and ends after 30 minutes.</p>
        <div class="mb-3"><label class="form-label" asp-for="Input.Email">Email <span aria-hidden="true">*</span></label><input class="form-control" asp-for="Input.Email" type="email" autocomplete="email" required /><span class="text-danger" asp-validation-for="Input.Email"></span></div>
        <button class="btn btn-primary w-100" type="submit">Send reset link</button>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
