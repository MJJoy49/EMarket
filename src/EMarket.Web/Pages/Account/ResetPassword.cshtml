@page "/reset-password"
@using EMarket.Shared.Dtos.Auth
@{
    ViewData["Title"] = "Reset password";
}
@functions {
    [BindProperty] public ResetPasswordRequest Input { get; set; } = new();

    public void OnGet(string? token) => Input.Token = token ?? "";

    public async Task<IActionResult> OnPostAsync()
    {
        if (!ModelState.IsValid) { Input.NewPassword = Input.ConfirmPassword = ""; return Page(); }
        var result = await Api.PostAsync<Empty>("api/v1/auth/reset-password", Input);
        if (!result.Ok)
        {
            Input.NewPassword = Input.ConfirmPassword = "";
            ModelState.AddModelError(string.Empty, result.Message); // MSG08 for an old or used link
            return Page();
        }

        Success("Your password was changed. Please log in.");
        return RedirectToPage("/Account/Login");
    }
}

<div class="row justify-content-center"><div class="col-md-6 col-lg-5">
    <h1 class="h3">Reset password</h1>
    <form class="card card-body" method="post" novalidate>
        <input type="hidden" asp-for="Input.Token" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>
        <div class="mb-3"><label class="form-label" asp-for="Input.NewPassword">New password <span aria-hidden="true">*</span></label><input class="form-control" asp-for="Input.NewPassword" type="password" autocomplete="new-password" required /><div class="form-text">8 to 64 characters with an uppercase letter, a lowercase letter and a number.</div><span class="text-danger" asp-validation-for="Input.NewPassword"></span></div>
        <div class="mb-3"><label class="form-label" asp-for="Input.ConfirmPassword">Confirm password <span aria-hidden="true">*</span></label><input class="form-control" asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required /><span class="text-danger" asp-validation-for="Input.ConfirmPassword"></span></div>
        <button class="btn btn-primary w-100" type="submit">Reset password</button>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
