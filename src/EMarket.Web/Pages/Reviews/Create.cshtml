@page "/reviews/new/{orderItemId:guid}"
@using EMarket.Shared.Dtos.AfterSale
@{
    ViewData["Title"] = "Write a review";
}
@functions {
    [FromRoute] public Guid OrderItemId { get; set; }
    [BindProperty] public ReviewInput Input { get; set; } = new();

    public async Task<IActionResult> OnPostAsync()
    {
        if (!ModelState.IsValid) { return Page(); } // no stars: MSG03
        var result = await Api.PostAsync<System.Text.Json.JsonElement>($"api/v1/reviews/order-items/{OrderItemId}", Input);
        if (!result.Ok) { ModelState.AddModelError(string.Empty, result.Message); return Page(); }
        Success(Messages.ReviewPosted);
        return RedirectToPage("/Orders/Index");
    }
}

<h1 class="h3">Write a review</h1>
<form class="card card-body" method="post" style="max-width: 560px" novalidate>
    <div asp-validation-summary="All" class="text-danger mb-2" role="alert"></div>
    <fieldset class="mb-3">
        <legend class="h6">Your rating <span aria-hidden="true">*</span></legend>
        @for (var stars = 5; stars >= 1; stars--)
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="Input.Rating" id="r@(stars)" value="@stars" checked="@(Input.Rating == stars)" required />
                <label class="form-check-label" for="r@(stars)">@stars &#9733;</label>
            </div>
        }
    </fieldset>
    <div class="mb-3"><label class="form-label" asp-for="Input.Comment">Comment (up to 1000 characters)</label><textarea class="form-control" asp-for="Input.Comment" rows="4" maxlength="1000"></textarea></div>
    <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Post review</button><a class="btn btn-outline-secondary" asp-page="/Orders/Index">Cancel</a></div>
</form>
