@using Microsoft.AspNetCore.WebUtilities
@model (int Page, int TotalPages)
@functions {
    string Link(int page)
    {
        var values = Context.Request.Query.Where(q => q.Key != "page").ToDictionary(q => q.Key, q => q.Value.ToString());
        values["page"] = page.ToString();
        return QueryHelpers.AddQueryString(Context.Request.Path, values!);
    }
}
@if (Model.TotalPages > 1)
{
    var from = Math.Max(1, Model.Page - 2);
    var to = Math.Min(Model.TotalPages, Model.Page + 2);
    <nav aria-label="Pages">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page - 1)" aria-label="Previous page">&lsaquo;</a></li>
            @for (var p = from; p <= to; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@Link(p)" aria-current="@(p == Model.Page ? "page" : null)">@p</a></li>
            }
            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page + 1)" aria-label="Next page">&rsaquo;</a></li>
        </ul>
    </nav>
}
