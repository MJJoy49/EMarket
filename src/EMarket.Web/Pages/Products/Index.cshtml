@page "/products"
@using EMarket.Shared.Results
@{
    ViewData["Title"] = "Products";
}
@functions {
    public PagedResult<ProductListItemDto>? Results { get; private set; }
    public IReadOnlyList<CategoryDto> Categories { get; private set; } = [];
    public IReadOnlyList<string> Brands { get; private set; } = [];

    public async Task OnGetAsync([FromServices] SiteInfo site)
    {
        Categories = await site.CategoriesAsync();
        // The same query names go straight to the API: q, categoryId, minPrice, maxPrice, brand, minRating, inStockOnly, sort, page.
        var result = await Api.GetAsync<PagedResult<ProductListItemDto>>("api/v1/products" + Request.QueryString);
        if (Failed(result)) { return; }
        Results = result.Data;
        Guid.TryParse(Request.Query["categoryId"], out var categoryId);
        var brands = await Api.GetAsync<List<string>>("api/v1/products/brands" + (categoryId == Guid.Empty ? "" : $"?categoryId={categoryId}"));
        Brands = brands.Data ?? [];
    }

    private string Q(string name) => Request.Query[name].ToString();
}

<h1 class="h3">@(string.IsNullOrWhiteSpace(Q("q")) ? "Products" : $"Results for “{Q("q")}”")</h1>
@if (Results is not null)
{
    <p class="text-muted" role="status">@Results.TotalCount results</p>
}

<div class="row g-4">
    <aside class="col-lg-3" aria-label="Filters">
        <button class="btn btn-outline-secondary d-lg-none mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#filters" aria-expanded="false" aria-controls="filters">Filter and sort</button>
        <form id="filters" class="collapse d-lg-block card card-body" method="get">
            <input type="hidden" name="q" value="@Q("q")" />
            <div class="mb-3">
                <label class="form-label" for="categoryId">Category</label>
                <select class="form-select" id="categoryId" name="categoryId">
                    <option value="">All categories</option>
                    @foreach (var main in Categories)
                    {
                        <option value="@main.Id" selected="@(Q("categoryId") == main.Id.ToString())">@main.Name</option>
                        foreach (var child in main.Children)
                        {
                            <option value="@child.Id" selected="@(Q("categoryId") == child.Id.ToString())">&nbsp;&nbsp;@child.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-6"><label class="form-label" for="minPrice">Min price</label><input class="form-control" id="minPrice" name="minPrice" type="number" min="0" step="1" value="@Q("minPrice")" /></div>
                <div class="col-6"><label class="form-label" for="maxPrice">Max price</label><input class="form-control" id="maxPrice" name="maxPrice" type="number" min="0" step="1" value="@Q("maxPrice")" /></div>
            </div>
            @if (Brands.Count > 0)
            {
                <div class="mb-3">
                    <label class="form-label" for="brand">Brand</label>
                    <select class="form-select" id="brand" name="brand">
                        <option value="">All brands</option>
                        @foreach (var brand in Brands)
                        {
                            <option selected="@(string.Equals(Q("brand"), brand, StringComparison.OrdinalIgnoreCase))">@brand</option>
                        }
                    </select>
                </div>
            }
            <div class="mb-3">
                <label class="form-label" for="minRating">Rating</label>
                <select class="form-select" id="minRating" name="minRating">
                    <option value="">Any</option>
                    <option value="4" selected="@(Q("minRating") == "4")">4 stars and above</option>
                    <option value="3" selected="@(Q("minRating") == "3")">3 stars and above</option>
                </select>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="inStockOnly" name="inStockOnly" value="true" checked="@(Q("inStockOnly").StartsWith("true"))" />
                <label class="form-check-label" for="inStockOnly">In stock only</label>
            </div>
            <div class="mb-3">
                <label class="form-label" for="sort">Sort by</label>
                <select class="form-select" id="sort" name="sort">
                    <option value="newest" selected="@(Q("sort") is "" or "newest")">Newest</option>
                    <option value="price-asc" selected="@(Q("sort") == "price-asc")">Price: low to high</option>
                    <option value="price-desc" selected="@(Q("sort") == "price-desc")">Price: high to low</option>
                    <option value="top-rated" selected="@(Q("sort") == "top-rated")">Top rated</option>
                </select>
            </div>
            <button class="btn btn-primary" type="submit">Apply</button>
        </form>
    </aside>

    <section class="col-lg-9" aria-label="Product list">
        @if (Results is null)
        {
            <p class="text-muted">The product list is not available right now.</p>
        }
        else if (Results.Items.Count == 0)
        {
            <div class="card card-body text-center">
                <p class="mb-2">No products found.</p>
                <a asp-page="/Products/Index">See all categories</a>
            </div>
        }
        else
        {
            <div class="row row-cols-2 row-cols-md-3 g-3">
                @foreach (var product in Results.Items)
                {
                    <div class="col"><partial name="_ProductCard" model="product" /></div>
                }
            </div>
            <div class="mt-4"><partial name="_Pager" model="(Results.Page, Results.TotalPages)" /></div>
        }
    </section>
</div>
